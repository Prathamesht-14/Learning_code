<!DOCTYPE html>
<html lang="en">
<head>
   <%- include('./partials/head') %>
   <title>Blog</title>
</head>
<body>
   <%- include('./partials/nav') %>
   <div class="container mt-4">
      <h1><%= blog.title %></h1>
      <img src="/public/<%- blog.coverImageURL %>" width="500px"/>
      <pre><%= blog.body %></pre>
   </div>
   <div class="container mt-4">
      <img src="/public/<%= blog.createdBy.profileImageURL %>" width="100px"/><%= blog.createdBy.fullName %>
   </div>

   <div class="container mt-3">
      
      <% if (locals.user) { %>
         <form action="/blog/comment/<%= blog._id %>" method="post">
            <div class="mb-3">
              <input type="text" class="form-control" name="content" placeholder="Enter your Comments">
              <button class="btn btn-sm btn-primary mt-3" type="submit">Add</button>
            </div>
         </form>  <!-- Closed the form tag here -->
      <% } %>

      <div class="mt-3">
         <h1>Comments (<%= comments.length %>)</h1>
         <% comments.forEach(comment => { %>
          <div>
            <img src="/public/<%= comment.createdBy.profileImageURL %>" width="100px"/><%= comment.createdBy.fullName %>
            <pre><%= comment.content %></pre>  <!-- Render the comment content properly -->
          </div>
         <% }) %>
      </div>
   </div>  <!-- Closing the div properly -->

   <%- include('./partials/scripts') %>
</body>
</html>
